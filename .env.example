# ==============================================================================
# Konfiguracja CoinMarketCap Daily Diamonds Auto-Claimer (.env)
# Skopiuj ten plik jako '.env' i uzupełnij swoimi danymi.
# ==============================================================================

# [WYMAGANE] Token autoryzacyjny CoinMarketCap (JWT z nagłówka 'Authorization: Bearer <token>' lub cookie 'u-prod')
# Wystarczy wkleić sam token 'eyJhbGci...' lub pełny nagłówek 'Bearer eyJhbGci...'
CMC_AUTH_TOKEN="eyJhbGciOi..."

# [OPCJONALNIE] URL Webhooka Discord do powiadomień
# Przykład: https://discord.com/api/webhooks/1234567890/abcdef...
DISCORD_WEBHOOK_URL=""

# [OPCJONALNIE] Konfiguracja powiadomień Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# [OPCJONALNIE] Własny serwer proxy (HTTP/HTTPS/SOCKS5)
# Przykład: http://user:pass@proxy-ip:port lub socks5://user:pass@proxy-ip:port
PROXY_URL=""

# [OPCJONALNIE] Pominięcie losowego oczekiwania w oknie porannym (true/1 = natychmiastowe wykonanie)
SKIP_DELAY=false
